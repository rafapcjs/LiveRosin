APP_NAME="Tienda"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tienda
DB_USERNAME=tienda
DB_PASSWORD=tienda

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción con HTTPS pon esto en true:
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Correo para los avisos de seguridad. En tu computador queda en el registro (log).
# En el servidor, por ejemplo con Gmail (usa una "contraseña de aplicación"):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tucorreo@gmail.com
#   MAIL_PASSWORD=contraseña-de-aplicacion
#   MAIL_FROM_ADDRESS=tucorreo@gmail.com
MAIL_MAILER=log
MAIL_FROM_ADDRESS="avisos@tienda.test"
MAIL_FROM_NAME="${APP_NAME}"

# Usuario administrador (php artisan tienda:crear-admin)
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@tutienda.com
ADMIN_PASSWORD=pon-aqui-una-clave-larga-con-numeros-123

# Pedir a Google y otros buscadores que no muestren el catálogo (true/false)
STORE_NOINDEX=true

# Minutos sin usar el panel antes de cerrar la sesión sola
ADMIN_IDLE_MINUTES=30

# Visitas por minuto permitidas a cada persona (protección contra abusos)
RATE_PUBLIC_PER_MINUTE=120
RATE_ADMIN_PER_MINUTE=300
